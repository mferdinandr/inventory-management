generator client {
  provider         = "prisma-client"
  output           = "../generated/prisma"
  previewFeatures   = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  extensions  = [citext]
}

// ---------------------------------------------------------------------------
// Enumerasi (docs/03-erd.md bab 2)
// ---------------------------------------------------------------------------

enum UserRole {
  PLATFORM_OWNER
  SUPERADMIN
  ADMIN
  PIC_ROOM
  TECHNICIAN
  VIEWER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum LocationType {
  BUILDING
  FLOOR
  DEPARTMENT
  ROOM
}

enum AssetStatus {
  AVAILABLE
  IN_USE
  ON_LOAN
  UNDER_REPAIR
  AT_VENDOR
  DAMAGED
  LOST
  DISPOSED
}

enum AssetCondition {
  GOOD
  MINOR_ISSUE
  NEEDS_REPAIR
  UNUSABLE
}

enum EventType {
  CREATED
  INSPECTION
  MAINTENANCE
  REPAIR
  CALIBRATION
  LOAN_OUT
  LOAN_RETURN
  TRANSFER
  STATUS_CHANGE
  NOTE
  DISPOSAL
  CORRECTION
  LABEL_PRINTED
}

enum BorrowerType {
  INTERNAL_USER
  EXTERNAL_PERSON
}

enum MaintenanceType {
  CALIBRATION
  PREVENTIVE
  CORRECTIVE
}

enum MaintenanceResult {
  PASS
  PASS_WITH_NOTE
  FAIL
}

enum FundingSource {
  APBD
  APBN
  BLUD
  HIBAH
  KSO
  LAINNYA
}

enum VendorType {
  SUPPLIER
  SERVICE
  CALIBRATION
}

enum DisposalReason {
  RUSAK_TOTAL
  HILANG
  DIHIBAHKAN
  DIJUAL
  KEDALUWARSA
  LAINNYA
}

enum PrintReason {
  FIRST_PRINT
  LABEL_DAMAGED
  LABEL_LOST
  LABEL_FADED
  RELOCATED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

// ---------------------------------------------------------------------------
// organizations
// ---------------------------------------------------------------------------

model Organization {
  id                           String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                         String             @db.Text
  code                         String             @unique @db.Text
  status                       OrganizationStatus @default(TRIAL)
  address                      String?            @db.Text
  logoObjectKey                String?            @map("logo_object_key") @db.Text
  timezone                    String             @default("Asia/Jakarta") @db.Text
  loanOverdueThresholdDays     Int                @default(7) @map("loan_overdue_threshold_days")
  quotaAssets                  Int                @default(2000) @map("quota_assets")
  quotaStorageBytes            BigInt             @default(21474836480) @map("quota_storage_bytes")
  quotaUsers                   Int                @default(50) @map("quota_users")
  usedStorageBytes             BigInt             @default(0) @map("used_storage_bytes")
  showGovernmentFields         Boolean            @default(true) @map("show_government_fields")
  contactName                   String?            @map("contact_name") @db.Text
  contactEmail                  String?            @map("contact_email") @db.Text
  contactPhone                  String?            @map("contact_phone") @db.Text
  notesInternal                 String?            @map("notes_internal") @db.Text
  createdAt                     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  users             User[]
  locations         Location[]
  categories        Category[]
  vendors           Vendor[]
  assets            Asset[]
  assetEvents      AssetEvent[]
  attachments      Attachment[]
  loans            Loan[]
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceRecords MaintenanceRecord[]
  labelPrints      LabelPrint[]
  auditLogs        AuditLog[]
  emailLogs       EmailLog[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// users
// ---------------------------------------------------------------------------

model User {
  id                String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId   String?        @map("organization_id") @db.Uuid
  email            String         @db.Citext
  name             String         @db.Text
  phone            String?        @db.Text
  passwordHash     String?        @map("password_hash") @db.Text
  role             UserRole
  status           UserStatus     @default(INVITED)
  employeeNumber   String?        @map("employee_number") @db.Text
  jobTitle         String?        @map("job_title") @db.Text
  inviteTokenHash  String?       @map("invite_token_hash") @db.Text
  inviteExpiresAt  DateTime?      @map("invite_expires_at") @db.Timestamptz(6)
  totpSecret       String?        @map("totp_secret") @db.Text
  totpEnabledAt     DateTime?      @map("totp_enabled_at") @db.Timestamptz(6)
  recoveryCodes     String[]       @map("recovery_codes")
  lastLoginAt       DateTime?      @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  locations        UserLocation[]
  picLocations     Location[]          @relation("LocationPic")
  assetsCreated    Asset[]             @relation("AssetCreatedBy")
  assetsResponsible Asset[]             @relation("AssetResponsible")
  assetEvents      AssetEvent[]
  loansAsBorrower  Loan[]             @relation("LoanBorrower")
  loansRecorded     Loan[]             @relation("LoanRecordedBy")
  loansReturned     Loan[]             @relation("LoanReturnedBy")
  attachmentUploads Attachment[]        @relation("AttachmentUploadedBy")
  maintenanceRecordsCreated MaintenanceRecord[] @relation("MaintenanceCreatedBy")
  labelPrints       LabelPrint[]
  auditLogs        AuditLog[]
  sessions          Session[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// user_locations — cakupan PIC_ROOM
// ---------------------------------------------------------------------------

model UserLocation {
  userId     String @map("user_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([userId, locationId])
  @@index([locationId])
  @@map("user_locations")
}

// ---------------------------------------------------------------------------
// locations
// ---------------------------------------------------------------------------

model Location {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  parentId      String?      @map("parent_id") @db.Uuid
  type          LocationType
  name          String       @db.Text
  code          String?      @db.Text
  picUserId     String?      @map("pic_user_id") @db.Uuid
  path          String       @db.Text
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parent       Location?       @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children     Location[]       @relation("LocationTree")
  picUser      User?           @relation("LocationPic", fields: [picUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userAssignments UserLocation[]
  assets        Asset[]
  assetEvents   AssetEvent[]

  @@index([organizationId])
  @@index([parentId])
  @@index([path])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// categories
// ---------------------------------------------------------------------------

model Category {
  id                             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId                 String   @map("organization_id") @db.Uuid
  parentId                      String?  @map("parent_id") @db.Uuid
  name                          String    @db.Text
  code                          String?   @db.Text
  isMedicalDevice               Boolean   @default(false) @map("is_medical_device")
  defaultCalibrationIntervalMonths Int?   @map("default_calibration_interval_months")
  defaultEconomicLifeYears      Int?      @map("default_economic_life_years")
  isActive                     Boolean   @default(true) @map("is_active")

  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parent       Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children     Category[]       @relation("CategoryTree")
  assets       Asset[]

  @@index([organizationId])
  @@index([parentId])
  @@map("categories")
}

// ---------------------------------------------------------------------------
// vendors
// ---------------------------------------------------------------------------

model Vendor {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name          String       @db.Text
  type          VendorType[]
  contactPerson String?      @map("contact_person") @db.Text
  phone         String?      @db.Text
  email         String?      @db.Text
  address       String?      @db.Text
  isActive      Boolean      @default(true) @map("is_active")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assets       Asset[]
  maintenanceRecords MaintenanceRecord[]

  @@index([organizationId])
  @@map("vendors")
}

// ---------------------------------------------------------------------------
// assets
// ---------------------------------------------------------------------------

model Asset {
  id                     String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId         String          @map("organization_id") @db.Uuid
  publicId              String          @unique @map("public_id") @db.Text
  assetCode             String          @map("asset_code") @db.Text
  name                  String          @db.Text
  categoryId            String?         @map("category_id") @db.Uuid
  locationId            String          @map("location_id") @db.Uuid
  status                 AssetStatus      @default(AVAILABLE)
  condition              AssetCondition     @default(GOOD)
  brand                 String?         @db.Text
  model                 String?         @db.Text
  serialNumber          String?         @map("serial_number") @db.Text
  yearManufactured      Int?            @map("year_manufactured")
  acquisitionDate        DateTime?       @map("acquisition_date") @db.Date
  acquisitionCost       Decimal?       @map("acquisition_cost") @db.Decimal(16,2)
  fundingSource          FundingSource?  @map("funding_source")
  acquisitionDocumentNo String?         @map("acquisition_document_no") @db.Text
  vendorId              String?         @map("vendor_id") @db.Uuid
  warrantyUntil          DateTime?       @map("warranty_until") @db.Date
  economicLifeYears      Int?            @map("economic_life_years")
  responsibleUserId      String?         @map("responsible_user_id") @db.Uuid
  primaryPhotoKey        String?         @map("primary_photo_key") @db.Text
  notes                  String?         @db.Text
  disposalReason          DisposalReason? @map("disposal_reason")
  disposedAt             DateTime?        @map("disposed_at") @db.Date
  disposedRecordedAt     DateTime?        @map("disposed_recorded_at") @db.Timestamptz(6)
  disposalRevertUntil    DateTime?       @map("disposal_revert_until") @db.Timestamptz(6)
  statusBeforeDisposal    AssetStatus?     @map("status_before_disposal")
  qrFirstPrintedAt        DateTime?        @map("qr_first_printed_at") @db.Timestamptz(6)
  createdBy              String          @map("created_by") @db.Uuid
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization            Organization?          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category                Category?               @relation(fields: [categoryId], references: [id],onDelete: Restrict,onUpdate: Cascade)
  location                Location                  @relation(fields: [locationId], references: [id],onDelete: Restrict,onUpdate: Cascade)
  vendor                  Vendor?                 @relation(fields: [vendorId], references: [id],onDelete: Restrict,onUpdate: Cascade)
  createdByUser           User                      @relation("AssetCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responsibleUser         User?                    @relation("AssetResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  events                  AssetEvent[]
  loans                   Loan[]
  maintenanceSchedules   MaintenanceSchedule[]
  maintenanceRecords      MaintenanceRecord[]
  labelPrints             LabelPrint[]

  @@unique([organizationId, assetCode])
  @@index([organizationId, locationId])
  @@index([organizationId, status])
  @@index([organizationId, categoryId])
  @@index([organizationId, serialNumber])
  @@map("assets")
}

// ---------------------------------------------------------------------------
// asset_events — riwayat append-only
// ---------------------------------------------------------------------------

model AssetEvent {
  id              String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  assetId        String     @map("asset_id") @db.Uuid
  type           EventType
  title          String     @db.Text
  notes          String?    @db.Text
  occurredAt     DateTime   @map("occurred_at") @db.Timestamptz(6)
  recordedAt     DateTime   @default(now()) @map("recorded_at") @db.Timestamptz(6)
  recordedBy     String     @map("recorded_by") @db.Uuid
  locationId     String?    @map("location_id") @db.Uuid
  statusBefore   AssetStatus? @map("status_before")
  statusAfter    AssetStatus?  @map("status_after")
  correctsEventId String? @map("corrects_event_id") @db.Uuid
  metadata       Json      @default("{}") @db.JsonB

  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict,onUpdate: Cascade)
  asset          Asset             @relation(fields: [assetId], references: [id], onDelete: Restrict,onUpdate: Cascade)
  recordedByUser User              @relation(fields: [recordedBy], references: [id], onDelete: Restrict,onUpdate: Cascade)
  location       Location?        @relation(fields: [locationId], references: [id], onDelete: Restrict,onUpdate: Cascade)
  correctsEvent  AssetEvent?     @relation("EventCorrection", fields: [correctsEventId], references: [id], onDelete: Restrict,onUpdate: Cascade)
  corrections     AssetEvent[]     @relation("EventCorrection")
  attachments     Attachment[]
  loansCheckout   Loan[]           @relation("LoanCheckoutEvent")
  loansCheckin    Loan[]           @relation("LoanCheckinEvent")
  maintenanceRecords MaintenanceRecord[]

  @@index([assetId])
  @@index([organizationId, type])
  @@index([organizationId])
  @@map("asset_events")
}

// ---------------------------------------------------------------------------
// attachments
// ---------------------------------------------------------------------------

model Attachment {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  objectKey      String   @map("object_key") @db.Text
  mimeType       String   @map("mime_type") @db.Text
  sizeBytes       BigInt   @map("size_bytes") @db.BigInt
  width           Int?
  height          Int?
  originalFilename String? @map("original_filename") @db.Text
  uploadedBy     String   @map("uploaded_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict,onUpdate: Cascade)
  event        AssetEvent    @relation(fields: [eventId], references: [id], onDelete: Restrict,onUpdate: Cascade)
  uploadedByUser User         @relation("AttachmentUploadedBy", fields: [uploadedBy], references: [id], onDelete: Restrict,onUpdate: Cascade)

  @@index([eventId])
  @@index([organizationId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// loans
// ---------------------------------------------------------------------------

model Loan {
  id                  String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId      String         @map("organization_id") @db.Uuid
  assetId            String         @map("asset_id") @db.Uuid
  borrowerType       BorrowerType   @map("borrower_type")
  borrowerUserId     String?        @map("borrower_user_id") @db.Uuid
  borrowerName       String?        @map("borrower_name") @db.Text
  borrowerPhone      String?        @map("borrower_phone") @db.Text
  borrowerUnit       String?        @map("borrower_unit") @db.Text
  purpose            String         @db.Text
  borrowedAt        DateTime       @map("borrowed_at") @db.Timestamptz(6)
  dueAt             DateTime?      @map("due_at") @db.Timestamptz(6)
  returnedAt        DateTime?      @map("returned_at") @db.Timestamptz(6)
  conditionOut      AssetCondition  @map("condition_out")
  conditionIn       AssetCondition? @map("condition_in")
  returnNotes       String?        @map("return_notes") @db.Text
  checkoutEventId   String         @map("checkout_event_id") @db.Uuid
  checkinEventId    String?        @map("checkin_event_id") @db.Uuid
  recordedBy         String         @map("recorded_by") @db.Uuid
  returnedRecordedBy String?        @map("returned_recorded_by") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization?  @relation(fields: [organizationId], references: [id],onDelete: Restrict,onUpdate: Cascade)
  asset        Asset           @relation(fields: [assetId], references: [id],onDelete: Restrict,onUpdate: Cascade)
  borrowerUser User?          @relation("LoanBorrower", fields: [borrowerUserId], references: [id],onDelete: Restrict,onUpdate: Cascade)
  checkoutEvent AssetEvent    @relation("LoanCheckoutEvent", fields: [checkoutEventId], references: [id],onDelete: Restrict,onUpdate: Cascade)
  checkinEvent  AssetEvent?   @relation("LoanCheckinEvent", fields: [checkinEventId], references: [id],onDelete: Restrict,onUpdate: Cascade)
  recordedByUser  User           @relation("LoanRecordedBy", fields: [recordedBy], references: [id],onDelete: Restrict,onUpdate: Cascade)
  returnedRecordedByUser User?  @relation("LoanReturnedBy", fields: [returnedRecordedBy], references: [id],onDelete: Restrict,onUpdate: Cascade)

  @@index([organizationId])
  @@map("loans")
}

// ---------------------------------------------------------------------------
// maintenance_schedules
// ---------------------------------------------------------------------------

model MaintenanceSchedule {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  assetId       String           @map("asset_id") @db.Uuid
  type          MaintenanceType
  intervalMonths Int              @map("interval_months")
  lastPerformedAt DateTime?      @map("last_performed_at") @db.Date
  nextDueAt     DateTime         @map("next_due_at") @db.Date
  isActive      Boolean          @default(true) @map("is_active")
  notes          String?         @db.Text

  organization Organization?        @relation(fields: [organizationId], references: [id],onDelete: Restrict,onUpdate: Cascade)
  asset        Asset               @relation(fields: [assetId], references: [id],onDelete: Restrict,onUpdate: Cascade)
  records      MaintenanceRecord[]

  @@index([organizationId])
  @@index([assetId])
  @@map("maintenance_schedules")
}

// ---------------------------------------------------------------------------
// maintenance_records
// ---------------------------------------------------------------------------

model MaintenanceRecord {
  id                   String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId       String             @map("organization_id") @db.Uuid
  assetId             String             @map("asset_id") @db.Uuid
  scheduleId          String?            @map("schedule_id") @db.Uuid
  type                 MaintenanceType
  performedAt         DateTime           @map("performed_at") @db.Date
  performedByVendorId String?             @map("performed_by_vendor_id") @db.Uuid
  performedByInternal  String?             @map("performed_by_internal") @db.Text
  result                MaintenanceResult?
  validUntil           DateTime?            @map("valid_until") @db.Date
  certificateNumber     String?             @map("certificate_number") @db.Text
  certificateObjectKey  String?             @map("certificate_object_key") @db.Text
  cost                 Decimal?            @db.Decimal(16,2)
  partsReplaced        String?             @map("parts_replaced") @db.Text
  description           String?             @db.Text
  eventId              String              @map("event_id") @db.Uuid
  createdBy           String              @map("created_by") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization?     @relation(fields: [organizationId], references: [id],onDelete: Restrict,onUpdate: Cascade)
  asset        Asset            @relation(fields: [assetId], references: [id],onDelete: Restrict,onUpdate: Cascade)
  schedule     MaintenanceSchedule? @relation(fields: [scheduleId], references: [id],onDelete: Restrict,onUpdate: Cascade)
  vendor       Vendor?       @relation(fields: [performedByVendorId], references: [id],onDelete: Restrict,onUpdate: Cascade)
  event        AssetEvent     @relation(fields: [eventId], references: [id],onDelete: Restrict,onUpdate: Cascade)
  createdByUser User           @relation("MaintenanceCreatedBy", fields: [createdBy], references: [id],onDelete: Restrict,onUpdate: Cascade)

  @@index([organizationId])
  @@index([assetId])
  @@index([scheduleId])
  @@map("maintenance_records")
}

// ---------------------------------------------------------------------------
// label_prints
// ---------------------------------------------------------------------------

model LabelPrint {
  id             String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  assetId       String     @map("asset_id") @db.Uuid
  reason        PrintReason
  labelSize     String     @map("label_size") @db.Text
  printedBy     String     @map("printed_by") @db.Uuid
  printedAt     DateTime   @default(now()) @map("printed_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id],onDelete: Restrict,onUpdate: Cascade)
  asset        Asset        @relation(fields: [assetId], references: [id],onDelete: Restrict,onUpdate: Cascade)
  printedByUser User        @relation(fields: [printedBy], references: [id],onDelete: Restrict,onUpdate: Cascade)

  @@index([organizationId])
  @@index([assetId])
  @@map("label_prints")
}

// ---------------------------------------------------------------------------
// audit_logs
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  action         String   @db.Text
  entityType     String?   @map("entity_type") @db.Text
  entityId       String?   @map("entity_id") @db.Uuid
  changes        Json?    @db.JsonB
  ipAddress      String?   @map("ip_address") @db.Inet
  userAgent      String?   @map("user_agent") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id],onDelete: Restrict,onUpdate: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id],onDelete: Restrict,onUpdate: Cascade)

  @@index([organizationId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// email_logs
// ---------------------------------------------------------------------------

model EmailLog {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  toEmail       String   @map("to_email") @db.Text
  template       String   @db.Text
  subject        String?  @db.Text
  status         String   @db.Text
  error          String?  @db.Text
  sentAt        DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id],onDelete: Restrict,onUpdate: Cascade)

  @@index([organizationId])
  @@map("email_logs")
}

// ---------------------------------------------------------------------------
// Auth.js — sessions & verification_tokens (docs/03-erd.md bab 3.16)
// ---------------------------------------------------------------------------

model Session {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  sessionToken String   @unique @map("session_token") @db.Text
  expires      DateTime @db.Timestamptz(6)
  remembered    Boolean  @default(false)
  ipAddress     String?   @map("ip_address") @db.Inet
  userAgent     String?   @map("user_agent") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id],onDelete: Restrict,onUpdate: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String   @db.Text
  token      String   @db.Text
  expires    DateTime @db.Timestamptz(6)

  @@id([identifier, token])
  @@map("verification_tokens")
}